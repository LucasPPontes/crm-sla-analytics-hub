# ==========================================
# Root .gitignore - Hub Executivo CRM & SLA
# ==========================================

# Dependencies
node_modules/
frontend/node_modules/
backend/venv/
venv/
env/
ENV/

# Production Builds & Bundles
dist/
frontend/dist/
build/
.vite/
frontend/.vite/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.sqlite3

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
tmp/
scratch/

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
